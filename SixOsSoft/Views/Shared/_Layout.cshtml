@{
    var activeNav = ViewData["ActiveNav"]?.ToString() ?? "";
    var currentPath = Context.Request.Path.Value?.ToLower().TrimEnd('/') ?? "";
    if (string.IsNullOrEmpty(currentPath)) { currentPath = "/"; }

    bool isHome = activeNav == "Index" || currentPath == "" || currentPath == "/" || currentPath == "/trangchu" || currentPath == "/index.html";
    bool isGioiThieu = activeNav == "GioiThieu" || currentPath.Contains("gioi-thieu");
    bool isChuyenKhoa = activeNav == "ChuyenKhoa" || currentPath.Contains("chuyen-khoa");
    bool isDoiNgu = activeNav == "DoiNguBacSi" || currentPath.Contains("doi-ngu-bac-si");
    bool isDichVu = activeNav == "DichVu" || currentPath.Contains("dich-vu");
    bool isTinTuc = activeNav == "TinTuc" || currentPath.Contains("tin-tuc") || currentPath.Contains("bai-viet");
    bool isLienHe = activeNav == "LienHe" || currentPath.Contains("lien-he");
}
