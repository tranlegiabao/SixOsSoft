@{
    ViewData["Title"] = "Liên Hệ - Cơ Sở MINDLAB BẾN TRE";
}

<section class="breadcrumb-nav">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end">
                <div class="p-banner-left">

                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb m-0" itemscope itemtype="https://schema.org/BreadcrumbList">
                            <!-- Trang chủ -->
                            <li class="breadcrumb-item py-2" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <a href="/" itemprop="item">
                                    <span style="color: #6c757d" itemprop="name">Trang chủ</span>
                                </a>
                                <meta itemprop="position" content="1" />
                            </li>
                            <!-- Đối tác -->
                            <li class="breadcrumb-item active p-2" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <strong style="color: #6c757d;" class="text-contact fw-bold" itemprop="name">Liên hệ</strong>
                                <meta itemprop="position" content="2" />
                            </li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </section>
    <section class="container pb-5">
        <div class="heading">
            <h1>LIÊN HỆ - GÓP Ý</h1>
        </div>
        <div class="container-fluid form_lienhe">
            <section class="container">
                <div class="row">
                    <div class="col-lg-6">
                        <h2 class="title-contact text-lg-start text-center">
                            Cơ Sở MINDLAB BẾN TRE
                        </h2>
                        <div class="sixos-tinhNangChung">
                            <div class="d-flex">
                                <p style="padding-left: 35px; color: black">
                                    Địa chỉ: Số 224E1, Nguyễn Văn Tư, Khu phố Mỹ Tân, Phường Bến Tre, Tỉnh Vĩnh Long
                                </p>
                            </div>
                            <div class="d-flex">
                                <p style="padding-left: 35px; color: black">
                                    Điện thoại: 0275 3812 659 – 0983 341 224
                                </p>
                            </div>
                            <div class="d-flex">
                                <p style="padding-left: 35px; color: black">
                                    Email: hachau.xn@@gmail.com
                                </p>
                            </div>
                            <div class="d-flex">
                                <p style="padding-left: 35px; color: black; margin: 0">
                                    Giờ làm việc: 08:00 – 17:00 (Thứ 2 – Thứ 7, Chủ Nhật & ngày Lễ nghỉ)
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="card contact_lienhe" style="border: none">
                            <div class="card-body contactbody py-0">
                                <h2 class="title-contact1">Liên hệ với chúng tôi</h2>
                                <div class="row px-2">
                                    <div class="col-lg-6 p-1">
                                        <label class="form-label">
                                            Họ tên người liên hệ
                                            <span style="color: red">*</span>
                                        </label>
                                        <input id="SixOsLienHeName"
                                               type="text"
                                               class="title mt-0 mb-1 form-control"
                                               name="nameLienHe"
                                               required
                                               style="padding: 10px; border-radius: 20px" />
                                    </div>
                                    <div class="col-lg-6 p-1">
                                        <label class="form-label">Số điện thoại <span style="color: red">*</span></label>
                                        <input id="SixOsLienHePhone"
                                               type="tel"
                                               class="title mt-0 mb-1 form-control"
                                               name="phoneLienHe"
                                               required
                                               style="padding: 10px; border-radius: 20px" />
                                    </div>
 
                                    <div class="col-12 p-1">
                                        <label class="form-label">
                                            Ý kiến khách hàng
                                            <span style="color: red">*</span>
                                        </label>
                                        <textarea id="SixOsLienHeRequest"
                                                  class="title mt-0 mb-1 form-control"
                                                  name="requestLienHe"
                                                  required
                                                  style="padding: 10px; border-radius: 20px"></textarea>
                                    </div>
                                    <div class="col-12 p-1 mt-3 d-flex justify-content-center">
                                        <a style="font-size: 18px; width: 100%; color: white !important"
                                           id="SixOsLienHeBtn"
                                           href="#"
                                           class="btn btn-success text-center theme-btn mx-1">
                                            Liên hệ ngay
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </section>
