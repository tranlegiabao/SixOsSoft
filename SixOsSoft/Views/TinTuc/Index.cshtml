@{
    ViewData["Title"] = "Tin Tức - Cơ Sở MINDLAB BẾN TRE";
}

<section class="breadcrumb-nav ">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end">
                <div class="p-banner-left">

                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb m-0" itemscope itemtype="https://schema.org/BreadcrumbList">
                            <!-- Trang chủ -->
                            <li class="breadcrumb-item py-2" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <a href="/" itemprop="item">
                                    <span style="color: #6c757d" itemprop="name">Trang chủ</span>
                                </a>
                                <meta itemprop="position" content="1" />
                            </li>
                            <!-- Tin tức -->
                            <li class="breadcrumb-item py-2" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <a href="/tin-tuc" style="font-size:1rem" itemprop="item">
                                    <span style="color: #6c757d" itemprop="name">Tin tức</span>
                                </a>
                                <meta itemprop="position" content="2" />
                            </li>
                            <!-- Phần tử hiện tại -->
                            <li class="breadcrumb-item p-2 active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <strong style="color: #6c757d;" class="text-contact fw-bold" itemprop="name">Đào tạo - tập huấn</strong>
                                <meta itemprop="position" content="3" />
                            </li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </section>

    <section class="mt-responsive3" itemscope itemtype="http://schema.org/Blog">
        <section class="wpo-blog-highlights-section container" style="position: relative">

            <!-- Container hiển thị danh sách bài viết load từ API -->
            <div id="baiVietList" class="wpo-blog-highlights-wrap">
              <div class="row justify-content-center"></div>
            </div>

            <!-- Phân trang -->
            <div class="pagination-container text-center">
                <button id="prevPage" class="btn btn-outline-primary">⬅️ Trước</button>
                <span id="pageInfo"></span>
                <button id="nextPage" class="btn btn-outline-primary">Tiếp ➡️</button>
            </div>
        </section>
    </section>
