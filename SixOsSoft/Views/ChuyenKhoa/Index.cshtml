                    </li>
                    <li class="col-lg-3 col-md-6 col-sm-6 mb-4">
                        <article class="specialty-item">
                            <a href="/chuyen-khoa">
                                <figure>
                                    <img src="/images/icon/icon-ong-nghiem1.png" alt="Nhà thuốc GPP" class="img-fluid">
                                </figure>
