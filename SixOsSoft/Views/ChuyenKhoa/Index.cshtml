@{
    ViewData["Title"] = "Chuyên Khoa - Cơ Sở MINDLAB BẾN TRE";
}

<section class="breadcrumb-nav">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end">
                <div class="p-banner-left">

                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb m-0" itemscope itemtype="https://schema.org/BreadcrumbList">
                            <!-- Trang chủ -->
                            <li class="breadcrumb-item py-2" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <a href="/" itemprop="item">
                                    <span style="color: #6c757d" itemprop="name">Trang chủ</span>
                                </a>
                                <meta itemprop="position" content="1" />
                            </li>
                            <!-- Đối tác -->
                            <li class="breadcrumb-item active p-2" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <strong style="color: #6c757d;" class="text-contact fw-bold" itemprop="name">Chuyên khoa</strong>
                                <meta itemprop="position" content="2" />
                            </li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </section>


    <section id="chuyen-khoa" class="chuyen-khoa">
            <div class="heading">
                <h1>CHUYÊN KHOA</h1>
            </div>
            <div class="container">
                <ul class="row d-flex justify-content-center">
                    <li class="col-lg-3 col-md-6 col-sm-6 mb-4">
                        <article class="specialty-item">
                            <a href="/chuyen-khoa">
                                <figure>
                                    <img src="/images/icon/icon-khoa-noi-tong-quat.png" alt="Khoa Nội tổng quát" class="img-fluid">
                                </figure>
                                <h3 class="one-line">Nội tổng quát</h3>
                            </a>
                        </article>
                    </li>
                    <li class="col-lg-3 col-md-6 col-sm-6 mb-4">
                        <article class="specialty-item">
                            <a href="/chuyen-khoa">
                                <figure>
                                    <img src="/images/icon/icon-khoa-ngoai.png" alt="Ngoại khoa" class="img-fluid">
                                </figure>
                                <h3>Ngoại khoa</h3>
                            </a>
