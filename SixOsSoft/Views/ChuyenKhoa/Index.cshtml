                            </a>
                        </article>
                    </li>
                    <li class="col-lg-3 col-md-6 col-sm-6 mb-4">
                        <article class="specialty-item">
                            <a href="/chuyen-khoa">
                                <figure>
                                    <img src="/images/icon/icon-xet-nghiem.png" alt="Xét nghiệm" class="img-fluid">
                                </figure>
                                <h3>Xét nghiệm</h3>
                            </a>
                        </article>
                    </li>
                </ul>
            </div>
        </section>
